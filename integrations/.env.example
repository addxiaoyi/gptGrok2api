# Grok Register 部署环境变量
# cp integrations/.env.example integrations/.env && 编辑

# grok2api 远端入池配置
GROK2API_REMOTE_BASE=http://localhost:8000
GROK2API_REMOTE_APP_KEY=grok2api

# 邮箱服务（任选其一）
DUCKMAIL_API_KEY=
YYDS_API_KEY=
YYDS_JWT=
CLOUDFLARE_API_BASE=
CLOUDFLARE_API_KEY=

# 代理配置
PROXY_MODE=auto
PROXY=

# 注册配置
REGISTER_COUNT=1
MULTI_THREAD_ENABLED=false
MULTI_THREAD_WORKERS=4

# 日志级别
LOG_LEVEL=INFO
